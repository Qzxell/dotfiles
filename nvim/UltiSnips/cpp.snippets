snippet binpow "binary pow"
ll binpow(int b,int e){
	ll ret = 1;
	while( e > 0){
		if( e&1){
			ret = ret * b;
		}
		b = b * b;
		e >>= 1;
	}
	return ret;
}
endsnippet

