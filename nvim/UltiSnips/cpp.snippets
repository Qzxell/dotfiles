snippet fts "fenwick"
struct FT {
	vl ft;
	int lim ;

	FT(int n) : lim(n){
		ft.assign(n+1,0);
	}
	FT(vl &vec) {
		lim = sz(vec);
		ft.assign(lim+1,0);
		forn(i,sz(vec)){
			int ind = i + 1;//indx - 1
			int pat = ind + (ind & -ind);
			ft[ind] += vec[i];
			if(pat <= lim)
				ft[pat] += ft[ind];
		}
	}

	void updt(int pos,int modi){
		while( pos <= lim ){
			ft[pos] += modi;
			pos += pos&-pos;
		}
	}
	ll query(int pos){
		ll ret = 0;
		while(pos > 0 ){
			ret += ft[pos];
			pos -= pos & -pos;
		}
		return ret;
	}
	ll query(int l, int r){
		return query(r) - query(l-1);
	}
}
endsnippet


snippet ft "fenwick"
const int N = ${1:2e5 + 5};
ll ft[N];

void updt(int pos,int modi){
	while( pos <= lim ){
		ft[pos] += modi;
		pos += pos&-pos;
	}
}
ll query(int pos){
	ll ret = 0;
	while(pos > 0 ){
		ret += ft[pos];
		pos -= pos & -pos;
	}
	return ret;
}
ll query(int l, int r){
	return query(r) - query(l-1);
}
endsnippet
